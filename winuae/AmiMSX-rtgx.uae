config_description=AmiMSX RTG scanline check: rtgrt with GDI output (exact colours) and the RTG screen unscaled: PiStorm-like 68040 JIT + uaegfx Z3 RTG board; Workbench copy with the Uaegfx monitor (winuae\wbrtg)
use_gui=no
kickstart_rom_file=C:\AMD\bigmig-build\amiga_files\UPDATE3.2.3\ROMS\A1200.47.115.ROM
chipset=aga
chipset_compatible=A1200
cpu_model=68040
fpu_model=68040
cpu_compatible=false
cpu_cycle_exact=false
cpu_memory_cycle_exact=false
cpu_speed=max
cachesize=16384
cpu_24bit_addressing=false
chipmem_size=4
fastmem_size=0
z3mem_size=128
nr_floppies=1
floppy0type=0
filesystem2=rw,DH0:Workbench:C:\AMD\amimsx\winuae\wbrtg,5
uaehf0=dir,rw,DH0:Workbench:C:\AMD\amimsx\winuae\wbrtg,5
filesystem2=rw,DH9:AmiMSX:C:\AMD\amimsx\run,-128
uaehf1=dir,rw,DH9:AmiMSX:C:\AMD\amimsx\run,-128
gfx_fullscreen_amiga=false
gfx_width_windowed=1440
gfx_height_windowed=1080
gfx_linemode=double
sound_output=normal
input.magic_mouse=true
win32.start_not_captured=true
input.tablet=mousehack
input.mouse_untrap=magic_mouse
warp=false
gfxcard_size=64
gfxcard_type=ZorroIII
gfxcard_hardware_vblank=false
gfxcard_hardware_sprite=false
gfxcard_multithread=false
win32.rtg_match_depth=true
